{
  "Authentication": {
    "Issuer": "zpi-backend",
    "Audience": "zpi-app",
    "SigningKey": "",
    "AllowedWebOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Redis": {
    "KeyPrefix": "zpi:identity:"
  },
  "AccountDeletion": {
    "Enabled": true
  },
  "Routines": {
    "WorkerEnabled": true
  }
}
