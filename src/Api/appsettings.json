{
  "Authentication": {
    "Issuer": "zpi-backend",
    "Audience": "zpi-app",
    "SigningKey": "",
    "AllowedWebOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Redis": {
    "KeyPrefix": "zpi:identity:"
  },
  "AccountDeletion": {
    "Enabled": true
  },
  "Notifications": {
    "WorkerEnabled": true
  },
  "Routines": {
    "WorkerEnabled": true
  },
  "Safety": {
    "Alerts": {
      "Freshness": "00:05:00",
      "Confirmation": "00:00:30",
      "LowBatteryPercent": 20,
      "BatteryRearmPercent": 30
    }
  },
  "MedicalRecords": {
    "StorageRoot": "App_Data/medical-records",
    "MaxFileSizeBytes": 20971520,
    "MaxFilesPerRecord": 10,
    "CleanupWorkerEnabled": true,
    "StorageProvider": "S3",
    "S3": {
      "Endpoint": "https://localhost:8333",
      "Bucket": "zpi-medical",
      "Region": "us-east-1",
      "AccessKeyFile": "../../.local/seaweedfs/client/access-key",
      "SecretKeyFile": "../../.local/seaweedfs/client/secret-key",
      "CertificateAuthorityFile": "../../.local/seaweedfs/client/ca.crt"
    }
  },
  "Care": {
    "CleanupWorkerEnabled": true
  }
}
