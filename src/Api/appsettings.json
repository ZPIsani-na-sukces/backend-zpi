{
  "Authentication": {
    "Issuer": "zpi-backend",
    "Audience": "zpi-app",
    "SigningKey": "",
    "AllowedWebOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Redis": {
    "KeyPrefix": "zpi:identity:"
  },
  "AccountDeletion": {
    "Enabled": true
  },
  "Notifications": {
    "WorkerEnabled": true
  },
  "Routines": {
    "WorkerEnabled": true
  },
  "Safety": {
    "Alerts": {
      "Freshness": "00:05:00",
      "Confirmation": "00:00:30",
      "LowBatteryPercent": 20,
      "BatteryRearmPercent": 30
    }
  }
}
